	if (idx == 1) lcd_draw_circle(180, 90, BROWN, 20, 1);
	else if (idx == 2) lcd_draw_circle(180, 90, RED, 20, 1);
	else if (idx == 3) lcd_draw_circle(180, 170, BLACK, 20, 1);
}
